# Vagrant state and generated secrets - never commit these
.vagrant/
lab/.vagrant/
lab/.secrets/
*.log
*.box
.DS_Store

# Attack output - keep the folder, not its contents
attack/loot/*
!attack/loot/.gitkeep
attack/scripts/*.hashes
*.zip

# BloodHound / SharpHound collection artifacts (copied into lab/ during a session)
lab/*.zip
lab/sharphound/
lab/sharphound-output/
lab/*bloodhound.zip
*_bloodhound.zip
bloodhound/
docs/images/.gitkeep
