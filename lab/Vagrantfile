# -*- mode: ruby -*-
# Acme Widgets lab - Phase 1: corporate baseline
#
# WARNING: This environment is intentionally vulnerable. Corporate VMs sit on an
# isolated VirtualBox internal network. Never bridge them to a real network.
#
# Requires: VirtualBox 7.x, Vagrant 2.4+, and `vagrant plugin install vagrant-reload`

WIN_BOX   = "gusztavvargadr/windows-server-2022-standard"
LINUX_BOX = "bento/ubuntu-22.04"
CORP_NET  = "acme-corp"   # VirtualBox internal network, 10.10.10.0/24

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false

  # --- SIEM (brought up first so Windows agents can enroll) -----------------
  config.vm.define "siem01" do |s|
    s.vm.box      = LINUX_BOX
    s.vm.hostname = "siem01"
    s.vm.network "private_network", ip: "10.10.10.20", virtualbox__intnet: CORP_NET
    # Wazuh dashboard reachable only from your own machine
    s.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1"
    s.vm.provider "virtualbox" do |vb|
      vb.name   = "acme-siem01"
      vb.memory = 8192
      vb.cpus   = 4
    end
    s.vm.provision "shell", path: "scripts/siem01/install-wazuh.sh"
  end

  # --- Domain controller -----------------------------------------------------
  config.vm.define "dc01" do |dc|
    dc.vm.box          = WIN_BOX
    dc.vm.hostname     = "dc01"
    dc.vm.guest        = :windows
    dc.vm.communicator = "winrm"
    dc.vm.boot_timeout = 900
    dc.winrm.timeout   = 900
    dc.vm.network "private_network", ip: "10.10.10.10", virtualbox__intnet: CORP_NET
    dc.vm.provider "virtualbox" do |vb|
      vb.name   = "acme-dc01"
      vb.memory = 4096
      vb.cpus   = 2
      vb.gui    = false
    end
    dc.vm.provision "shell", path: "scripts/dc01/01-install-adds.ps1"
    dc.vm.provision :reload
    dc.vm.provision "shell", path: "scripts/dc01/02-configure-ad.ps1"
    dc.vm.provision "shell", path: "scripts/common/enable-auditing.ps1"
    dc.vm.provision "shell", path: "scripts/common/install-sysmon.ps1"
    dc.vm.provision "shell", path: "scripts/common/install-wazuh-agent.ps1"
  end

  # --- File server -----------------------------------------------------------
  config.vm.define "fs01" do |fs|
    fs.vm.box          = WIN_BOX
    fs.vm.hostname     = "fs01"
    fs.vm.guest        = :windows
    fs.vm.communicator = "winrm"
    fs.vm.boot_timeout = 900
    fs.winrm.timeout   = 900
    fs.vm.network "private_network", ip: "10.10.10.11", virtualbox__intnet: CORP_NET
    fs.vm.provider "virtualbox" do |vb|
      vb.name   = "acme-fs01"
      vb.memory = 3072
      vb.cpus   = 2
      vb.gui    = false
    end
    fs.vm.provision "shell", path: "scripts/fs01/01-join-domain.ps1"
    fs.vm.provision :reload
    fs.vm.provision "shell", path: "scripts/fs01/02-create-shares.ps1"
    fs.vm.provision "shell", path: "scripts/common/enable-auditing.ps1"
    fs.vm.provision "shell", path: "scripts/common/install-sysmon.ps1"
    fs.vm.provision "shell", path: "scripts/common/install-wazuh-agent.ps1"
  end
end
