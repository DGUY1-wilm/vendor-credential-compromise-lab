<!--
  Wazuh working detections for the vendor-credential-compromise lab.

  VERIFIED WORKING on Wazuh 4.9.2 in this lab. Key points learned while tuning:

  1. These Windows events arrive via the eventchannel and are decoded by the
     'json' decoder, so the rules match on <decoded_as>json</decoded_as> rather
     than on <if_group>windows</if_group>. Chaining off a parent group
     (if_group / if_sid) did NOT fire reliably here; decoded_as did.
  2. The Kerberoast 4769 event in this lab reports
     ticketEncryptionType = 0xffffffff (not the textbook 0x17 for RC4), so the
     rule matches both values. ALWAYS confirm the real value in your environment
     with wazuh-logtest before trusting a rule.
  3. Field paths use win.system.* and win.eventdata.* (no 'data.' prefix inside
     rules, even though the indexer DISPLAYS them as data.win.*).

  Install:
    paste into /var/ossec/etc/rules/local_rules.xml on siem01 (replace contents),
    then: sudo systemctl restart wazuh-manager
  Validate a rule without re-running the attack:
    sudo /var/ossec/bin/wazuh-logtest   (paste a real event; see detections/README.md)
  Custom rule IDs must be >= 100000.
-->
<group name="acme_lab,vendor_compromise,windows,">

  <!-- Kerberoasting: weak (RC4/0xffffffff) TGS request, excluding machine accounts -->
  <rule id="100100" level="12">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">0x17|0xffffffff</field>
    <field name="win.eventdata.serviceName" negate="yes">\$$</field>
    <description>Kerberoasting: weak service ticket requested for $(win.eventdata.serviceName)</description>
    <mitre><id>T1558.003</id></mitre>
    <group>kerberoast,credential_access,</group>
  </rule>

  <!-- Vendor account (v-*) authentication observed -->
  <rule id="100101" level="12">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4624$|^4625$</field>
    <field name="win.eventdata.targetUserName">^v-</field>
    <description>Vendor account $(win.eventdata.targetUserName) authentication observed</description>
    <mitre><id>T1078.002</id><id>T1199</id></mitre>
    <group>initial_access,</group>
  </rule>

  <!-- Service account (svc-*) granted special privileges at logon (admin use) -->
  <rule id="100102" level="10">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4672$</field>
    <field name="win.eventdata.subjectUserName">^svc-</field>
    <description>Service account $(win.eventdata.subjectUserName) assigned admin privileges at logon</description>
    <mitre><id>T1078.002</id></mitre>
    <group>lateral_movement,</group>
  </rule>

  <!-- Remote service install consistent with secretsdump/psexec -->
  <rule id="100103" level="12">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath">cmd.exe|powershell|ADMIN\$|\\pipe\\|%COMSPEC%</field>
    <description>Suspicious service install (possible credential dumping): $(win.eventdata.serviceName)</description>
    <mitre><id>T1003.001</id><id>T1003.002</id></mitre>
    <group>credential_access,</group>
  </rule>

  <!-- Sensitive share (Finance/HR) read by a vendor or service account -->
  <rule id="100104" level="10">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^5145$</field>
    <field name="win.eventdata.shareName">Finance|HR</field>
    <field name="win.eventdata.subjectUserName">^v-|^svc-</field>
    <description>Sensitive share $(win.eventdata.shareName) accessed by $(win.eventdata.subjectUserName)</description>
    <mitre><id>T1039</id></mitre>
    <group>collection,</group>
  </rule>

  <!-- New account added to Administrators -->
  <rule id="100105" level="10">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetSid">-544$</field>
    <description>Account $(win.eventdata.memberName) added to Administrators</description>
    <mitre><id>T1136.001</id><id>T1098</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- Scheduled task created -->
  <rule id="100106" level="8">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4698$</field>
    <description>Scheduled task created: $(win.eventdata.taskName)</description>
    <mitre><id>T1053.005</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- Honeytoken account used: any auth = critical -->
  <rule id="100107" level="14">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4624$|^4625$|^4768$|^4769$</field>
    <field name="win.eventdata.targetUserName">^svc-sql-admin$</field>
    <description>HONEYTOKEN: decoy account svc-sql-admin used from $(win.eventdata.ipAddress) - high confidence intrusion</description>
    <mitre><id>T1078</id></mitre>
    <group>credential_access,discovery,</group>
  </rule>

</group>
